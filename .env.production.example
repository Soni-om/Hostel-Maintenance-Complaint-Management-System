# ==============================================================================
# HOSTELCARE — PRODUCTION ENVIRONMENT VARIABLES TEMPLATE
# Platform: Cloud Deployment (Railway / Render / Managed MySQL)
#
# IMPORTANT: Never commit the active .env file to version control.
# Populate these values in your cloud hosting provider dashboard (e.g. Railway Variables).
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Server Configuration
# ------------------------------------------------------------------------------
NODE_ENV=production
# PORT is automatically injected by Railway/Render; default 5000 for local test
PORT=5000
API_PREFIX=/api/v1

# ------------------------------------------------------------------------------
# 2. Cross-Origin Resource Sharing (CORS) Allowlist
# Comma-separated list of permitted frontend domains (with HTTPS protocol)
# ------------------------------------------------------------------------------
FRONTEND_ORIGIN=https://hostelcare.up.railway.app,https://hostelcare.vercel.app,http://localhost:5000
CLIENT_URL=https://hostelcare.up.railway.app

# ------------------------------------------------------------------------------
# 3. Cloud MySQL Database Configuration
# Option A: Unified Connection URL (Railway / Render / Heroku auto-injects DATABASE_URL or MYSQL_URL)
# ------------------------------------------------------------------------------
# DATABASE_URL=mysql://root:password@mysql.railway.internal:3306/railway
# MYSQL_URL=mysql://root:password@mysql.railway.internal:3306/railway

# Option B: Discrete Parameters (when not using DATABASE_URL)
DB_HOST=mysql.railway.internal
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_production_mysql_password
DB_NAME=railway
DB_CONNECTION_LIMIT=10

# TLS/SSL for Cloud MySQL (Set to true when connecting over public proxy, Aiven, or TiDB Cloud)
DB_SSL=false
DB_SSL_REJECT_UNAUTHORIZED=true
# DB_SSL_CA=-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----

# ------------------------------------------------------------------------------
# 4. JSON Web Token (JWT) Cryptographic Secret
# MUST be at least 32 cryptographically secure random characters
# Generate with: node -e "console.log(crypto.randomBytes(32).toString('hex'))"
# ------------------------------------------------------------------------------
JWT_SECRET=generate_a_64_character_random_hex_string_for_production_security
JWT_EXPIRES_IN=7d

# ------------------------------------------------------------------------------
# 5. Durable Private File Storage Configuration
# Point UPLOAD_DIR to the persistent volume mount path (e.g., /app/backend/uploads)
# ------------------------------------------------------------------------------
UPLOAD_DIR=/app/backend/uploads
MAX_FILE_SIZE_BYTES=5242880
